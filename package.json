    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "enquirer": "^2.4.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "openai": "^7.4.0",
    "ora": "^9.4.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3",
